          "name": "Get Historical Rates",
          "request": {
            "name": "Get Historical Rates",
            "description": {
              "content": "Returns historical exchange rates for the given base currency on the specified date. Full currency support from 2021-01-01 onward; 35 currencies are available from 1990-01-01 to 2020-12-31. Only available on Pro, Business, and Volume plans.",
              "type": "text/plain"
            },
            "url": {
              "path": [
