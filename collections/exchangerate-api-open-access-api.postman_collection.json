              "path": [
                "v6",
                "latest",
                ":base_code"
              ],
              "host": [
                "open",
                "er-api",
                "com"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "base_code",
                  "description": "(Required) ISO 4217 three-letter currency code for the base currency (e.g. USD)."
                }
              ]
            },
